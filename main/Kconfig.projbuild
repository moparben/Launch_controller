menu "Touch calibration & overlay control"

config CAL_DISABLE_CALIBRATION
    bool "Disable touch calibration"
    default y
    help
        When enabled the touch calibration subsystem is disabled at build time.
        This prevents the calibration overlay/UI from running and helps when
        debugging UI behavior (touch input is still usable but calibration is
        not performed automatically).

config CAL_FORCE_DISABLE_OVERLAY
    bool "Force disable calibration overlay"
    default y
    help
        When enabled, the calibration UI overlay will never be created.
        This forces the driver and calibration code to skip all overlay
        registration, useful for debugging and automated builds.

endmenu
menu "Example Configuration"
    config EXAMPLE_USE_DMA2D_COPY_FRAME
        bool "Use DMA2D to copy draw buffer to frame buffer"
        default y
        help
            Enable this option, DMA2D will be used to copy the LVGL draw buffer to the target frame buffer.
            This can save some CPU time and improve the performance.

    config EXAMPLE_MONITOR_REFRESH_BY_GPIO
        bool "Monitor Refresh Rate by GPIO"
        default y
        help
            Enable this option, you can visualize the refresh rate by attaching a logic analyzer to a specific GPIO.
            The GPIO will output a square wave with the frequency equals to half of the refresh rate.

    choice
        prompt "Select MIPI LCD model"
        default EXAMPLE_LCD_USE_JD9365
        help
            Select LCD controller model.

        config EXAMPLE_LCD_USE_EK79007
            bool "EK79007"
        config EXAMPLE_LCD_USE_ILI9881C
            bool "ILI9881C"
        config EXAMPLE_LCD_USE_JD9365
            bool "JD9365 (Waveshare 10.1 inch)"
    endchoice
endmenu
